# Bloquear acceso directo al .env (compatible Apache 2.2 y 2.4)
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Security headers (si el módulo está disponible)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Bloquear archivos sensibles: logs de PHP (exponen usuario de BD y rutas),
# migraciones SQL (esquema), documentación y respaldos.
<FilesMatch "(^error_log$|\.(sql|md|log|bak|ini|sh|py)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Repositorio git (si se despliega con git en cPanel)
RedirectMatch 404 /\.git
