# Block access to sensitive files
<FilesMatch "^\.env$|^\.env\..*$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to PHP files inside db/ from the browser
<FilesMatch "^(config|csrf|ratelimit|mailer)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect db/ directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^db/ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
